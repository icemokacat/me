---
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="백엔드 개발자 포트폴리오" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans KR", Roboto, sans-serif;
    background: #fafafa;
    color: #2c2c2c;
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    border: 1px solid #e8e8e8;
    padding: 32px;
    margin-bottom: 24px;
    transition: all 0.2s ease;
  }

  .card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 8px;
  }

  h2 {
    font-size: 1.8rem;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 16px;
    border-bottom: 2px solid #3498db;
    padding-bottom: 8px;
  }

  h3 {
    font-size: 1.4rem;
    font-weight: 600;
    color: #34495e;
    margin-bottom: 12px;
  }

  p {
    color: #555;
    margin-bottom: 16px;
    text-align: left;
  }

  .text-center {
    text-align: center;
  }

  .btn {
    background: #3498db;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn:hover {
    background: #2980b9;
    transform: translateY(-1px);
  }

  .tag {
    display: inline-block;
    background: #ecf0f1;
    color: #2c3e50;
    padding: 4px 12px;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 500;
    margin: 2px 4px 2px 0;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 16px;
    }

    .card {
      padding: 24px;
      margin-bottom: 16px;
    }

    h1 {
      font-size: 2rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    h3 {
      font-size: 1.2rem;
    }
  }
</style>