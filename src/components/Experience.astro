---
interface Project {
  title: string;
  description: string;
  features: string[];
  detailUrl?: string;
}

const projects: Project[] = [
  {
    title: "🚀 시스템 아키텍처 & 인프라 구축",
    description: "시스템을 설계하고 안정적인 개발 환경을 구축한 경험",
    features: [
      "Jenkins를 이용한 CI/CD 파이프라인 구축",
      "SpringBoot 프로젝트 기반 아키텍처 구성 및 보안 설정",
      "데이터 마이그레이션 시스템 설계",
    ],
    detailUrl: "./md/exp1.md"
  },
  {
    title: "🦄 외부 시스템 연동 & API 개발",
    description: "다양한 외부 서비스와의 연동을 통해 통합 솔루션을 구현한 경험",
    features: [
      "SNS 연동을 통한 사용자 인증",
      "타사 제공 SSO 및 OTP 연동",
      "오픈 마켓 API 연동",
      "KMC, 이니시스 본인인증 API 연동",
    ],
    detailUrl: "./md/exp2.md"
  },
  {
    title: "⚡ 개발 문화 개선 & 협업 체계 구축",
    description: "팀의 생산성과 협업 효율성을 높이는 개발 환경을 구축",
    features: [
      "Git 기반 협업 체계 고도화",
      "사내 CS 플랫폼 개발 및 알림 시스템 구축",
      "Notion 기반 지식 공유 체계 구축",
      "API 명세서 자동화 시스템 구축"
    ],
    detailUrl: "./md/exp3.md"
  },
  {
    title: "🔧 레거시 시스템 개선 및 문제해결",
    description: "불편함을 없애는 작은 변화들",
    features: [
      "windows -> linux 서버 이전 및 인프라 개선",
      "CI/CD 폐쇄망 환경 대응 방안",
      "Springbatch를 이용한 Elasticsearch 데이터 증분 색인 처리",
      "기타 프로세스 개선"
    ],
    detailUrl: "./md/exp4.md"
  },
  
];
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">Experience</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card">
          <div class="project-header">
            <h3 class="project-title">{project.title}</h3>
          </div>
          <p class="project-description">{project.description}</p>
          
          <div class="project-features">
            <h4>주요 경험</h4>
            <ul>
              {project.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>
                    
          <div class="project-links">
            {project.detailUrl && (
              <button 
                class="btn btn-sm" 
                onclick={`openExperienceModal('${project.detailUrl}', '${project.title}')`}
              >
                상세 경험 보기
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border-top: 4px solid #f9c51d;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .project-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: #2c2c2c;
    margin: 0;
  }

  .project-period {
    color: #666;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .project-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .project-features {
    margin-bottom: 25px;
  }

  .project-features h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 12px;
  }

  .project-features ul {
    list-style: none;
    padding: 0;
  }

  .project-features li {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 8px;
    padding-left: 15px;
    position: relative;
  }

  .project-features li::before {
    content: '•';
    color: #f9c51d;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .project-tech {
    margin-bottom: 25px;
  }

  .project-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 8px 20px;
    font-size: 0.9rem;
  }

  .btn-outline {
    background: transparent;
    color: #2c2c2c;
    border: 2px solid #f9c51d;
  }

  .btn-outline:hover {
    background: #f9c51d;
    color: #2c2c2c;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    
    .project-card {
      padding: 25px;
    }
    
    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>