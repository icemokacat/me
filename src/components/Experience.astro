---
interface Project {
  title: string;
  description: string;
  features: string[];
  detailUrl?: string;
}

const projects: Project[] = [
  {
    title: "🚀 시스템 아키텍처 & 인프라 구축",
    description: "시스템을 설계하고 안정적인 개발 환경을 구축한 경험",
    features: [
      "CI/CD 파이프라인 구축",
      "데이터 마이그레이션 시스템 설계",
      "Springbatch를 이용한 데이터 처리",
    ],
    detailUrl: "./md/ecommerce-platform.md"
  },
  {
    title: "🦄 외부 시스템 연동 & API 개발",
    description: "다양한 외부 서비스와의 연동을 통해 통합 솔루션을 구현한 경험",
    features: [
      "SNS 연동을 통한 사용자 인증",
      "타사 제공 SSO 및 OTP 연동",
      "오픈 마켓 API 연동",
      "KMC, 이니시스 본인인증 API 연동",
    ],
    detailUrl: "./md/chat-service.md"
  },
  {
    title: "🔧 성능 최적화 & 기술 개선",
    description: "기존 시스템의 성능을 분석하고 개선한 경험",
    features: [
      "다양한 데이터 소스 연동",
      "실시간 데이터 처리",
      "커스텀 차트 생성",
      "실시간 데이터 동기화"
    ],
    detailUrl: "./md/data-dashboard.md"
  },
  {
    title: "💡 기술 스택 다양화 & 새로운 기술 도입",
    description: "프로젝트를 주도하고 팀과 협업하며 성과를 만들어낸 경험",
    features: [
      "라우팅 및 로드 밸런싱",
      "인증 및 권한 관리",
      "API 요청 제한",
      "분산 추적 시스템"
    ],
    detailUrl: "./md/api-gateway.md"
  },
  {
    title: "💼 프로젝트 리더십 & 팀 협업",
    description: "프로젝트를 주도하고 팀과 협업하며 성과를 만들어낸 경험",
    features: [
      "라우팅 및 로드 밸런싱",
      "인증 및 권한 관리",
      "API 요청 제한",
      "분산 추적 시스템"
    ],
    detailUrl: "./md/api-gateway.md"
  },
  
];
---

<section id="projects" class="section">
  <div class="container">
    <h2 class="section-title">Experience</h2>
    <div class="projects-grid">
      {projects.map((project) => (
        <div class="project-card">
          <div class="project-header">
            <h3 class="project-title">{project.title}</h3>
          </div>
          <p class="project-description">{project.description}</p>
          
          <div class="project-features">
            <h4>주요 경험</h4>
            <ul>
              {project.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
          </div>
                    
          <div class="project-links">
            {project.detailUrl && (
              <button 
                class="btn btn-sm" 
                onclick={`openExperienceModal('${project.detailUrl}', '${project.title}')`}
              >
                상세 경험 보기
              </button>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-card {
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    border-top: 4px solid #f9c51d;
  }

  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .project-title {
    font-size: 1.4rem;
    font-weight: 600;
    color: #2c2c2c;
    margin: 0;
  }

  .project-period {
    color: #666;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .project-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .project-features {
    margin-bottom: 25px;
  }

  .project-features h4 {
    font-size: 1rem;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 12px;
  }

  .project-features ul {
    list-style: none;
    padding: 0;
  }

  .project-features li {
    color: #666;
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 8px;
    padding-left: 15px;
    position: relative;
  }

  .project-features li::before {
    content: '•';
    color: #f9c51d;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .project-tech {
    margin-bottom: 25px;
  }

  .project-links {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 8px 20px;
    font-size: 0.9rem;
  }

  .btn-outline {
    background: transparent;
    color: #2c2c2c;
    border: 2px solid #f9c51d;
  }

  .btn-outline:hover {
    background: #f9c51d;
    color: #2c2c2c;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    
    .project-card {
      padding: 25px;
    }
    
    .project-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>