---

<section id="experience" class="experience-section">
  <div class="container">
    <h2>경험</h2>
    
    {experiences.map((exp, index) => (
      <div class="card experience-card">
        <div class="big-experience">
          <h3>{exp.company}</h3>
          <div class="position-period">
            <span class="position">{exp.position}</span>
            <span class="period">{exp.period}</span>
          </div>
          <p class="description">{exp.description}</p>
        </div>
        
        <div class="small-experiences">
          <h4>주요 프로젝트</h4>
          <div class="small-experience-list">
            {exp.smallExperiences.map((smallExp, smallIndex) => (
              <div 
                class="small-experience-item" 
                data-experience={`${index}-${smallIndex}`}
              >
                <div class="small-exp-header">
                  <h5>{smallExp.title}</h5>
                  <span class="small-period">{smallExp.period}</span>
                </div>
                <p class="small-description">{smallExp.description}</p>
                <div class="tech-tags">
                  {smallExp.technologies.map(tech => (
                    <span class="tag">{tech}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const smallExpItems = document.querySelectorAll('.small-experience-item');
    
    smallExpItems.forEach(item => {
      item.addEventListener('click', function() {
        const experienceIndex = this.getAttribute('data-experience');
        
        const event = new CustomEvent('openModal', {
          detail: { experienceIndex }
        });
        document.dispatchEvent(event);
      });
    });
  });
</script>

<style>
  .experience-section {
    padding: 80px 0;
  }

  .experience-card {
    margin-bottom: 48px;
  }

  .big-experience {
    margin-bottom: 40px;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(225, 229, 235, 0.8);
    position: relative;
  }

  .big-experience::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 80px;
    height: 2px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 1px;
  }

  .big-experience h3 {
    color: #1a1b1e;
    margin-bottom: 12px;
    font-size: 1.6rem;
    font-weight: 700;
  }

  .position-period {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .position {
    font-weight: 600;
    color: #4a5568;
    font-size: 1.1rem;
  }

  .period {
    color: #64748b;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .description {
    color: #64748b;
    line-height: 1.7;
    font-size: 1.05rem;
  }

  .small-experiences h4 {
    color: #2d3748;
    margin-bottom: 24px;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .small-experience-list {
    display: grid;
    gap: 20px;
  }

  .small-experience-item {
    padding: 24px;
    border: 1px solid rgba(225, 229, 235, 0.8);
    border-radius: 16px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(248, 250, 252, 0.6);
    position: relative;
    overflow: hidden;
  }

  .small-experience-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.3), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .small-experience-item:hover {
    border-color: rgba(102, 126, 234, 0.3);
    background: rgba(255, 255, 255, 0.9);
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(102, 126, 234, 0.15);
  }

  .small-experience-item:hover::before {
    opacity: 1;
  }

  .small-exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  .small-exp-header h5 {
    margin: 0;
    color: #2d3748;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .small-period {
    color: #64748b;
    font-size: 0.9rem;
    white-space: nowrap;
    margin-left: 12px;
    font-weight: 500;
  }

  .small-description {
    margin-bottom: 16px;
    color: #64748b;
    line-height: 1.6;
    font-size: 1.05rem;
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tech-tags .tag {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 12px;
    box-shadow: 0 2px 4px rgba(102, 126, 234, 0.2);
  }

  .tech-tags .tag:hover {
    background: linear-gradient(135deg, #5a67d8 0%, #6b46c1 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(102, 126, 234, 0.3);
  }

  @media (max-width: 768px) {
    .experience-section {
      padding: 40px 0;
    }

    .position-period {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .small-exp-header {
      flex-direction: column;
      gap: 4px;
    }

    .small-period {
      margin-left: 0;
    }

    .small-experience-item {
      padding: 16px;
    }
  }
</style>