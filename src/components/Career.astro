---
interface CareerItem {
  company: string;
  position: string;
  period: string;
  description: string;
  achievements: string[];
}

const career: CareerItem[] = [
  {
    company: "(주) 이씨오",
    position: "",
    period: "2023.04 - 현재",
    description: "도서관 SI 사업 및 자사 서비스 개발 및 운영을 담당",
    achievements: [
      "자사 서비스 및 SI 사업 관련 CI/CD 구축",
      "Spring Batch를 이용한 Elasticsearch 데이터 증분색인 처리",
      "경기도 사이버도서관 마이그레이션 프로그램 개발",
      "드림 시큐리티 제공 OTP 및 SSO 연동",
      "KMC, 이니시스 제공 본인인증 API 연동 및 화면 개발",
      "SNS 연동을 통한 사용자 인증 및 권한 관리",
      "Spring Security filter chain 및 customizing 을 통한 보안 정책 수립 후 구현",
      "RestTemplate 을 활용한 다양한 OpenAPI 연동",
      "SpringBoot 기반 프로젝트 구조 설계 및 초기 셋업 주도"
    ]
  },
  {
    company: "주식회사 멸치",
    position: "",
    period: "2022.02 - 2022.06",
    description: "자사 쇼핑몰 및 외부 이커머스 연계 시스템 개발 및 운영을 담당",
    achievements: [
      "검색엔진 이전 (solr > Elasticsearch)",
      "Qoo10 플랫폼 오픈마켓 API 연동 (클레임)",
      "자사몰 반려동물용품 관련 신규 API 개발 및 PC/모바일 화면 개발"
    ]
  },
  {
    company: "(주)콘넥시오",
    position: "",
    period: "2022.07 - 2023.02",
    description: "",
    achievements: [
      "IP 카메라 영상 암복호화 (rtsp ffmpeg)",
      "기타 사내 프로젝트 프로토타입 제작 (flutter, dart)",
    ]
  },
  {
    company: "(주)이씨오",
    position: "",
    period: "2017.07 - 2021.06",
    description: "도서 큐레이션  자사 서비스 개발 및 운영을 담당",
    achievements: [
      "스토리보드 요구사항에 따른 도메인 및 테이블 설계",
      "유저 및 CMS 백엔드 API 개발, 환경구축 담당",
      "Mybatis Cache 사용으로 조회 성능 개선",
      "공공도서관 소장정보 API 연동",
      "JWT를 이용한 로그인 관리"
    ]
  },
  {
    company: "(주)파크엘아이씨티",
    position: "",
    period: "2016.07 - 2016.11",
    description: "웹 서비스 개발을 담당하며, 백엔드 개발 기초를 다졌습니다.",
    achievements: [
      "입찰/낙찰 데이터 API 연동 및 화면개발",
      "나라장터 공고 크롤링",
      "JqGrid 플러그인 기반 CMS 개발",
      "Highchart 플러그인을 이용한 데이터 시각화 구현"
    ]
  }
];
---

<section id="career" class="section" style="background: #f8f9fa;">
  <div class="container">
    <h2 class="section-title">Career</h2>
    <div class="career-timeline">
      {career.map((item, index) => (
        <div class="career-item">
          <div class="career-marker">
            <div class="marker-dot"></div>
            {index < career.length - 1 && <div class="marker-line"></div>}
          </div>
          <div class="career-content">
            <div class="career-header">
              <h3 class="company-name">{item.company}</h3>
              <span class="career-period">{item.period}</span>
            </div>
            <h4 class="position">{item.position}</h4>
            <p class="career-description">{item.description}</p>
            <div class="achievements">
              <h5>주요 성과</h5>
              <ul>
                {item.achievements.map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .career-timeline {
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  .career-item {
    display: flex;
    margin-bottom: 50px;
    position: relative;
  }

  .career-marker {
    flex-shrink: 0;
    width: 30px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 30px;
  }

  .marker-dot {
    width: 20px;
    height: 20px;
    background: #f9c51d;
    border-radius: 50%;
    border: 4px solid white;
    box-shadow: 0 0 0 2px #f9c51d;
    z-index: 2;
  }

  .marker-line {
    width: 2px;
    height: 100%;
    background: #e0e0e0;
    margin-top: 10px;
    min-height: 150px;
  }

  .career-content {
    flex: 1;
    background: white;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    position: relative;
  }

  .career-content::before {
    content: '';
    position: absolute;
    left: -10px;
    top: 25px;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-right: 10px solid white;
  }

  .career-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 10px;
    flex-wrap: wrap;
    gap: 10px;
  }

  .company-name {
    font-size: 1.4rem;
    font-weight: 600;
    color: #2c2c2c;
    margin: 0;
  }

  .career-period {
    color: #666;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
  }

  .position {
    font-size: 1.1rem;
    font-weight: 500;
    color: #f9c51d;
    margin: 0 0 15px 0;
  }

  .career-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
  }

  .achievements h5 {
    font-size: 1rem;
    font-weight: 600;
    color: #2c2c2c;
    margin-bottom: 15px;
  }

  .achievements ul {
    list-style: none;
    padding: 0;
  }

  .achievements li {
    color: #666;
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 10px;
    padding-left: 20px;
    position: relative;
  }

  .achievements li::before {
    content: '✓';
    color: #f9c51d;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  @media (max-width: 768px) {
    .career-marker {
      margin-right: 20px;
    }
    
    .career-content {
      padding: 25px;
    }
    
    .career-content::before {
      left: -8px;
      border-right: 8px solid white;
    }
    
    .career-header {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .company-name {
      font-size: 1.2rem;
    }
  }
</style>